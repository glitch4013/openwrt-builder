
config wifi-device 'radio0'
	option type 'mac80211'
	option channel '11'
	option path 'platform/qca953x_wmac'
	option htmode 'HT20'
	option disabled '0'
	option hwmode '11g'
	option txpower '18'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'Hassan'
	option encryption 'psk2'
	option key '1200611Aa@'

config wifi-iface 'sta'
	option device 'radio0'
	option mode 'sta'
	option ssid 'modem'
	option encryption 'psk2'
	option key '1200611Aa@'
	option network 'wwan'

