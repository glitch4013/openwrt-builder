#!/bin/sh

while ! ip link show dev br-lan >/dev/null 2>&1; do
    sleep 2
done

sleep 3

tc qdisc del dev br-lan root 2>/dev/null
tc qdisc add dev br-lan root handle 1: htb default 10
tc class add dev br-lan parent 1: classid 1:1 htb rate 100mbit

i=2
while [ $i -le 14 ]; do
    tc class add dev br-lan parent 1:1 classid 1:$i htb rate 1mbit ceil 1mbit burst 15k cburst 15k
    tc qdisc add dev br-lan parent 1:$i handle $i: fq_codel 2>/dev/null || true
    tc filter add dev br-lan parent 1:0 protocol ip prio 1 u32 match ip dst 10.200.0.$i classid 1:$i
    i=$((i+1))
done

tc qdisc del dev wlan0 root 2>/dev/null
tc qdisc add dev wlan0 root handle 2: htb default 10
tc class add dev wlan0 parent 2: classid 2:1 htb rate 100mbit

j=2
while [ $j -le 14 ]; do
    tc class add dev wlan0 parent 2:1 classid 2:$j htb rate 1mbit ceil 1mbit burst 15k cburst 15k
    tc qdisc add dev wlan0 parent 2:$j handle $j: fq_codel 2>/dev/null || true
    tc filter add dev wlan0 parent 2:0 protocol ip prio 1 u32 match ip dst 192.168.1.$j classid 2:$j
    j=$((j+1))
done

exit 0
